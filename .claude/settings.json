{
  "permissions": {
    "allow": [
      "Bash(./mvnw:*)",
      "Bash(mvn:*)",
      "Bash(npm run:*)",
      "Bash(npm ci)",
      "Bash(npx ng:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git switch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(gh issue view:*)",
      "Bash(gh pr view:*)",
      "Bash(bash scripts/revision-codex.sh:*)",
      "Bash(docker build:*)",
      "Bash(docker compose config:*)",
      "Bash(docker compose build:*)"
    ],
    "deny": [
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.*.local)",
      "Read(./**/.env.prod*)",
      "Read(./**/.env.dev*)",
      "Read(./**/.env.test*)",
      "Read(./**/.env.staging*)",
      "Read(./**/*.pem)",
      "Read(./**/application-prod.yml)",
      "Bash(git push --force:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin master:*)",
      "Bash(gh pr merge:*)",
      "Bash(rm -rf:*)",
      "Bash(bash scripts/desplegar.sh:*)",
      "Bash(ssh:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/proteger-archivos.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/formatear.sh\""
          }
        ]
      }
    ]
  }
}